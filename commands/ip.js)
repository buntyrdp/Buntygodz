const axios = require('axios')
const iplookup = async (sock, chatId, { text, reply }) => {
    if (!text) return reply('IP Address toh do!')
    try {
        let res = await axios.get(`http://ip-api.com/json/${text}`)
        let data = res.data
        if (data.status === 'fail') return reply('Invalid IP Address!')
        
        let info = `*--- IP DETAILS ---*\n\n` +
                   `📍 *City:* ${data.city}\n` +
                   `🗺️ *Region:* ${data.regionName}\n` +
                   `🌍 *Country:* ${data.country}\n` +
                   `🏢 *ISP:* ${data.isp}\n` +
                   `🛰️ *Lat/Lon:* ${data.lat}, ${data.lon}`
        reply(info)
    } catch (e) {
        reply('Server error!')
    }
}
module.exports = { command: 'iplookup', execute: iplookup };
